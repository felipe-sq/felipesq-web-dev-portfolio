  "lint-staged": {
    "*.{js,mjs,json,md,mdx,yml,scss,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "fathom-client": "^3.7.2",
    "framer-motion": "^12.43.0",
    "next": "^16.3.0",
    "next-seo": "^6.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
